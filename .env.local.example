# Copy to frontend/.env.local
# URL of the backend API (the backend serves every route under /api/v3 as well).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v3
NEXT_PUBLIC_COMPANY_NAME=TAD Logistics
# AI calls and interview scheduling are not part of the current release; keep these pages hidden.
NEXT_PUBLIC_ENABLE_INTERVIEW_FEATURES=false
